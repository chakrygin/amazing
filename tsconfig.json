{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": [ "node", "jest" ],
    "paths": {
      "@core/*": [ "./core/*" ],
      "@src/*": [ "./src/*" ],
    },
  },
  "include": [ "core", "src", "tests" ],
  "exclude": [ "dist", "node_modules" ]
}
